    {
      "name": "01. Auth",
      "item": [
        {
          "name": "Токен читателя",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\nif (response.access) {\r\n    pm.environment.set(\"access_token\", response.access);\r\n}\r\nif (response.refresh) {\r\n    pm.environment.set(\"refresh_token\", response.refresh);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"reader3@example.com\",\r\n  \"password\": \"StrongPass123!\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/users/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "users",
                "token",
                ""
              ]
            }
          },
          "response": []
        },
        {
          "name": "Токен библиотекаря",
          "event": [
            {
              "listen": "test",
